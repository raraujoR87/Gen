# Trading mode gate. NEVER set to "live" in an example/dev environment.
# Real order dispatch is only enabled when this is explicitly "live" AND
# the exchange API key backing it has been validated as withdrawal-disabled.
TRADING_MODE=testnet

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/arbitrage

# --- Redis (order book cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Key vault / envelope encryption ---
# Name of the modal.Secret holding the KMS master key used to encrypt
# exchange_accounts.encrypted_api_key / encrypted_api_secret at rest.
KMS_SECRET_NAME=arbitrage-secrets
ENVELOPE_KEY_ID=change-me

# --- Risk defaults (overridable per user via RiskLimits) ---
MIN_ALPHA_BPS=15.0
MIN_EXECUTION_PROBABILITY=0.85
MAX_ADVERSE_HAZARD=0.20
MAX_NOTIONAL_USD_PER_TRADE=50.0
MAX_DAILY_NOTIONAL_USD=500.0

# --- Modal.com ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Local paper-trading runner (backend/marketdata/runner.py) ---
# See RUN_LOCAL.md. This runs entirely locally: real market data in,
# simulated (paper) orders only — no real exchange orders are ever placed
# by this runner, regardless of TRADING_MODE.
RUNNER_ENABLED=true
# Format: "SYMBOL:exchange_buy:exchange_sell,SYMBOL2:exchange_buy2:exchange_sell2"
# Exchange ids are ccxt ids (e.g. binance, kraken, bybit, coinbase). More
# pairs = more opportunities to hunt (each runs its own concurrent feed —
# see backend/marketdata/runner.py) and a livelier dashboard. Real markets
# are efficient, so most pairs will sit at a small negative spread most of
# the time — watching more of them is what actually improves the odds of
# catching a real one, not tuning any single pair.
#
# Kept to binance/kraken/bybit here: each exchange's websocket order-book
# feed has its own quirks (e.g. Bybit spot only accepts depth {1,50,200},
# Kraken only {10,25,100,500,1000} — see
# backend/marketdata/ws_ingestion.py's _DEFAULT_DEPTH_BY_EXCHANGE), so
# adding a new exchange here means it may need a new entry there too. 16
# pairs means 32 concurrent websocket connections — plenty for a normal
# machine/network, but trim this list if yours struggles.
MONITORED_PAIRS=BTC/USDT:binance:kraken,BTC/USDT:binance:bybit,ETH/USDT:binance:bybit,ETH/USDT:kraken:bybit,SOL/USDT:binance:kraken,SOL/USDT:kraken:bybit,XRP/USDT:binance:kraken,XRP/USDT:binance:bybit,ADA/USDT:binance:kraken,ADA/USDT:kraken:bybit,DOGE/USDT:binance:bybit,DOGE/USDT:binance:kraken,LTC/USDT:binance:kraken,LTC/USDT:kraken:bybit,LINK/USDT:binance:bybit,LINK/USDT:binance:kraken

# Triangular arbitrage: three legs on a SINGLE exchange (quote -> bridge ->
# target -> quote, e.g. USDT -> BTC -> ETH -> USDT), all fired concurrently
# once approved — see backend/execution/triangular.py. No cross-exchange
# transfer or latency race, unlike MONITORED_PAIRS above; this is the more
# realistic path if you want to move beyond research/validation toward
# actually trading, since it isn't competing against colocated HFT infra
# the same way cross-exchange latency arbitrage is.
# Format: "QUOTE:BRIDGE:TARGET:exchange,QUOTE2:BRIDGE2:TARGET2:exchange2"
MONITORED_TRIANGLES=USDT:BTC:ETH:binance,USDT:BTC:SOL:binance,USDT:ETH:SOL:binance

NOTIONAL_PER_TRADE_USD=50.0
DEFAULT_TAKER_FEE_BPS=10.0
POLL_INTERVAL_S=2.0
LOCAL_USER_EMAIL=local@paper-trading.dev

# Logs every evaluated tick's real (features, net_alpha_bps) to
# SAMPLE_LOG_PATH as JSONL — real, non-fabricated data for a future
# backend.ml.train run, once enough of it has accumulated. See
# backend/marketdata/sample_logger.py.
SAMPLE_LOGGING_ENABLED=true
SAMPLE_LOG_PATH=data/training_samples.jsonl
