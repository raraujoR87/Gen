# Trading mode gate. NEVER set to "live" in an example/dev environment.
# Real order dispatch is only enabled when this is explicitly "live" AND
# the exchange API key backing it has been validated as withdrawal-disabled.
TRADING_MODE=testnet

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/arbitrage

# --- Redis (order book cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Key vault / envelope encryption ---
# Name of the modal.Secret holding the KMS master key used to encrypt
# exchange_accounts.encrypted_api_key / encrypted_api_secret at rest.
KMS_SECRET_NAME=arbitrage-secrets
ENVELOPE_KEY_ID=change-me

# --- Risk defaults (overridable per user via RiskLimits) ---
MIN_ALPHA_BPS=15.0
MIN_EXECUTION_PROBABILITY=0.85
MAX_ADVERSE_HAZARD=0.20
MAX_NOTIONAL_USD_PER_TRADE=50.0
MAX_DAILY_NOTIONAL_USD=500.0

# --- Modal.com ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
